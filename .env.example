# ==============================================================================
# ArogyaSaathi Environment Configuration Template
# NOTE: Do NOT put production secrets in this file. Keep secrets out of git.
# ==============================================================================

# Application Environment
NODE_ENV=development
APP_ENV=local
NEXT_PUBLIC_APP_NAME="ArogyaSaathi"
NEXT_PUBLIC_APP_TAGLINE="Har Gaon, Har Ghar, Swasth Bharat"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Public API URL (for future frontend integration)
NEXT_PUBLIC_API_BASE_URL="http://localhost:8000/api/v1"

# Feature Flags
NEXT_PUBLIC_ENABLE_HINDI_LOCALIZATION=true
NEXT_PUBLIC_SHOW_DEVELOPMENT_BANNERS=true

# Backend Database (Phase 3+)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_password
POSTGRES_DB=arogyasaathi_dev

# Redis & Background Tasks (Phase 3+)
REDIS_URL="redis://localhost:6379/0"

# JWT Security (Phase 3+)
SECRET_KEY=dev_secret_key_change_in_production_min_32_characters_long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Speech-to-Text & AI Service (Phase 4+)
BHASHINI_API_KEY=""
BHASHINI_USER_ID=""
SPEECH_MODEL_PROVIDER="synthetic_mock"

